@model bartering.Models.Donation

@{
    ViewData["Title"] = "Delete Donation";
}

<div class="container mt-5">

    <h1>Delete Donation</h1>

    <div class="alert alert-warning">
        Are you sure you want to delete this donation?
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Donor
        </dt>

        <dd class="col-sm-9">
            @(Model.IsAnonymous ? "Anonymous" : Model.DonorName)
        </dd>

        <dt class="col-sm-3">
            Amount
        </dt>

        <dd class="col-sm-9">
            €@Model.Amount.ToString("N2")
        </dd>

        <dt class="col-sm-3">
            Date
        </dt>

        <dd class="col-sm-9">
            @Model.DonationDate.ToLocalTime()
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>