@model IEnumerable<bartering.Models.Donation>

@{
    ViewData["Title"] = "Donations";
}

<div class="container mt-5">

    <h1>Donations</h1>

    <p>
        Donations received through the website.
    </p>

    <table class="table table-striped table-hover">

        <thead>

            <tr>
                <th>Donor</th>
                <th>Amount</th>
                <th>Message</th>
                <th>Date</th>
                <th></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var donation in Model)
            {
                <tr>

                    <td>
                        @(donation.IsAnonymous
                            ? "Anonymous"
                            : donation.DonorName)
                    </td>

                    <td>
                        €@donation.Amount.ToString("N2")
                    </td>

                    <td>
                        @(string.IsNullOrEmpty(donation.Message)
                            ? "-"
                            : donation.Message)
                    </td>

                    <td>
                        @donation.DonationDate
                        .ToLocalTime()
                        .ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        <a asp-action="Delete"
                           asp-route-id="@donation.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>