@model bartering.Models.Item
<div class="col">
    <div class="card item-card h-100 shadow-sm">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Title"
                 class="card-img-top"
                 style="height: 200px; object-fit: cover;" />
        }
        else
        {
            <div class="card-img-top item-card-img item-card-placeholder d-flex align-items-center justify-content-center">
                <span class="text-muted">No photo</span>
            </div>
        }
        <div class="card-body d-flex flex-column">
            <span class="badge bg-secondary align-self-start mb-2">@Model.Category</span>
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text text-muted small flex-grow-1">@Model.Description.Substring(0, Math.Min(Model.Description.Length, 90))@(Model.Description.Length > 90 ? "…" : "")</p>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">@Model.Condition</small>
                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">View</a>
            </div>
        </div>
    </div>
</div>
