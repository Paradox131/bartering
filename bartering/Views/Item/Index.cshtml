@model bartering.Models.ViewModels.BrowseViewModel
@{
    ViewData["Title"] = "Browse items";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Browse items</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ List item</a>
    }
</div>
<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search title, description…" />
    </div>
    <div class="col-md-4">
        <select name="category" class="form-select">
            <option value="">All categories</option>
            @foreach (var cat in Model.Categories)
            {
                if (Model.Category == cat)
                {
                    <option value="@cat" selected="selected">@cat</option>
                }
                else
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
</form>
@if (Model.Items.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded bg-white">
        <p>No items match your search.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Items)
        {
            <partial name="_ItemCard" model="item" />
        }
    </div>
}
