@model bartering.Models.ViewModels.ItemFormViewModel
@{
    ViewData["Title"] = "List an item";
}
<h1 class="h3 mb-4">List an item for swap</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-lg-8">
    <partial name="_ItemFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Publish listing</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
