@model bartering.Models.ViewModels.ItemFormViewModel
@{
    ViewData["Title"] = "Edit item";
}
<h1 class="h3 mb-4">Edit listing</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="col-lg-8">
    <partial name="_ItemFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
