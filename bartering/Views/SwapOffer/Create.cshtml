@model bartering.Models.ViewModels.SwapProposalViewModel
@{
    ViewData["Title"] = "Propose swap";
}
<h1 class="h3 mb-2">Propose a swap</h1>
<p class="text-muted mb-4">
    You want <strong>@Model.RequestedItemTitle</strong> from @Model.RequestedItemOwner.
    Pick one of your available items to offer in return.
</p>
<form asp-action="Create" method="post" class="col-lg-7">
    <input type="hidden" asp-for="RequestedItemId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="OfferedItemId" class="form-label"></label>
        <select asp-for="OfferedItemId" class="form-select">
            <option value="">— Select your item —</option>
            @foreach (var item in Model.MyAvailableItems)
            {
                <option value="@item.Id">@item.Title (@item.Category)</option>
            }
        </select>
        <span asp-validation-for="OfferedItemId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Message" class="form-label"></label>
        <textarea asp-for="Message" class="form-control" rows="3" placeholder="Optional note to the owner…"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send swap offer</button>
    <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.RequestedItemId" class="btn btn-link">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}