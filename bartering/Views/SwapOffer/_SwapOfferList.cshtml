@model IReadOnlyList<bartering.Models.SwapOffer>
<div class="list-group">
    @foreach (var offer in Model)
    {
        <a asp-action="Details" asp-route-id="@offer.Id" class="list-group-item list-group-item-action">
            <div class="d-flex w-100 justify-content-between align-items-start">
                <div>
                    <strong>@offer.OfferedItem.Title</strong>
                    <span class="text-muted"> ⇄ </span>
                    <strong>@offer.RequestedItem.Title</strong>
                    <div class="small text-muted mt-1">
                        @offer.FromUser.DisplayName → @offer.ToUser.DisplayName
                    </div>
                </div>
                <span class="badge bg-light text-dark border">@offer.Status</span>
            </div>
        </a>
    }
</div>
