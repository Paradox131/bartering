@model bartering.Models.SwapOffer
@{
    ViewData["Title"] = "Swap offer";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isReceiver = userId == Model.ToUserId;
    var isSender = userId == Model.FromUserId;
}
<h1 class="h3 mb-4">Swap offer #@Model.Id</h1>
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Offered by @Model.FromUser.DisplayName</div>
            <div class="card-body">
                <h5 class="card-title">@Model.OfferedItem.Title</h5>
                <p class="text-muted small">@Model.OfferedItem.Category · @Model.OfferedItem.Condition</p>
                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.OfferedItemId">View item →</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Requested from @Model.ToUser.DisplayName</div>
            <div class="card-body">
                <h5 class="card-title">@Model.RequestedItem.Title</h5>
                <p class="text-muted small">@Model.RequestedItem.Category · @Model.RequestedItem.Condition</p>
                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.RequestedItemId">View item →</a>
            </div>
        </div>
    </div>
</div>
<p>
    <span class="badge @(Model.Status == bartering.Models.Enum.SwapOfferStatus.Pending ? "bg-warning text-dark" : Model.Status == bartering.Models.Enum.SwapOfferStatus.Accepted ? "bg-info text-dark" : Model.Status == bartering.Models.Enum.SwapOfferStatus.Completed ? "bg-success" : "bg-secondary")">
        @Model.Status
    </span>
    <span class="text-muted small ms-2">Sent @Model.CreatedAt.ToLocalTime().ToString("f")</span>
</p>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <blockquote class="blockquote border-start ps-3 my-4">
        <p class="mb-0">@Model.Message</p>
        <footer class="blockquote-footer mt-1">@Model.FromUser.DisplayName</footer>
    </blockquote>
}
@if (Model.Status == bartering.Models.Enum.SwapOfferStatus.Accepted)
{
    <div class="alert alert-info">
        <strong>Swap accepted!</strong> Coordinate delivery or meet-up with the other user, then mark complete when done.
        @if (isReceiver || isSender)
        {
            <div class="mt-2 small">
                Contact:
                @if (isReceiver)
                {
                    <span>@Model.FromUser.Email</span>
                }
                else
                {
                    <span>@Model.ToUser.Email</span>
                }
            </div>
        }
    </div>
}
<div class="d-flex flex-wrap gap-2">
    @if (Model.Status == bartering.Models.Enum.SwapOfferStatus.Pending && isReceiver)
    {
        <form asp-action="Accept" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Accept swap</button>
        </form>
        <form asp-action="Decline" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">Decline</button>
        </form>
    }
    @if (Model.Status == bartering.Models.Enum.SwapOfferStatus.Pending && isSender)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Cancel offer</button>
        </form>
    }
    @if (Model.Status == bartering.Models.Enum.SwapOfferStatus.Accepted && (isReceiver || isSender))
    {
        <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Mark swap complete</button>
        </form>
    }
</div>